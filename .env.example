# Copy to .env and fill in. .env is git-ignored: never commit it.

AS_EMAIL=team20@theschoolofai.in
AS_KEYSTONE_PASSWORD=
AS_SURYODAYA_PASSWORD=

# Your own model key (the brief requires your own keys). Leave blank to use the
# offline scripted model only.
ANTHROPIC_API_KEY=
AS_MODEL=claude-sonnet-5

# Budget guard (per question)
AS_MAX_TURNS=12
AS_MAX_MCP_CALLS=80
AS_MAX_USD=0.50
# Price per million tokens, used for the cost ledger. Check your provider's pricing.
AS_PRICE_IN_PER_MTOK=3.0
AS_PRICE_OUT_PER_MTOK=15.0

# AS_ALLOW_WRITES is ignored in this file on purpose. Set it only in the shell, for the
# single deliberate live write run:
#   AS_ALLOW_WRITES=1 python -m harness run TI2 --target live --model anthropic --live-apply --set live-write

# actor_kind for the agent's AgentSession rows: 'user', 'system', or blank.
# 'agent' is not allowed by the platform. Leave blank until staff answer Q7.
AS_ACTOR_KIND=
